<?xml version="1.0"?>
<robot name="light_seeker" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- Constants -->
  <!-- ============================= -->
 
  <xacro:property name="wheel_radius" value="0.175"/>
  <xacro:property name="wheel_width"  value="0.145"/>
  <xacro:property name="wheel_sep"    value="0.835"/>

  <!-- ============================= -->
  <!-- Base Link -->
  <!-- ============================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.062329" rpy="0 0 0"/>
      <mass value="46.064"/>
      <inertia ixx="0.615397" ixy="-0.0240585" ixz="-0.120749"
               iyy="1.75388"  iyz="-0.0028322" izz="2.03641"/>
    </inertial>

    <visual>
      <origin xyz="-1.57768 -0.78292 -1.12211" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://ros2_control_demo_example_2/meshes/Light_seeker_base_2.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1 1 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================= -->
  <!-- Base Footprint -->
  <!-- ============================= -->
  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.94 ${0.345*2 + 0.145} 0.01"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.94 ${0.345*2 + 0.145} 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.33" rpy="0 0 0"/>
  </joint>

  <!-- ============================= -->
  <!-- Wheel Macro -->
  <!-- ============================= -->
  <xacro:macro name="wheel" params="name x y axis_y">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.637"/>
        <inertia ixx="0.02467" ixy="0" ixz="0"
                 iyy="0.04411" iyz="0" izz="0.02467"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2} ${pi/2}"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi/2} ${pi/2}"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.155" rpy="0 0 0"/>
      <axis xyz="0 ${axis_y} 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ============================= -->
  <!-- Instantiate Wheels -->
  <!-- ============================= -->
  <xacro:wheel name="front_left_wheel_link"  x="0.295"  y="0.345" axis_y="1"/>
  <xacro:wheel name="rear_left_wheel_link"   x="-0.295" y="0.345" axis_y="1"/>
  <xacro:wheel name="front_right_wheel_link" x="0.295"  y="-0.345" axis_y="-1"/>
  <xacro:wheel name="rear_right_wheel_link"  x="-0.295" y="-0.345" axis_y="-1"/>

  <!-- ============================= -->
  <!-- Top Plate -->
  <!-- ============================= -->
  <link name="Top_plate_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.01"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="Top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="Top_plate_link"/>
    <origin xyz="0 0 0.095" rpy="0 0 0"/>
  </joint>

  <!-- ============================= -->
  <!-- ros2_control -->
  <!-- ============================= -->
  <ros2_control name="light_seeker_control" type="system">
    <hardware>
      <plugin>ros2_control_demo_example_2/DiffBotSystemHardware</plugin>
      <param name="example_param_hw_start_duration_sec">0</param>
      <param name="example_param_hw_stop_duration_sec">3.0</param>
    </hardware>

    <!-- LEFT SIDE -->
    <joint name="front_left_wheel_link_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_link_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RIGHT SIDE -->
    <joint name="front_right_wheel_link_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_link_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
